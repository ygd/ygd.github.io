---

<section
  class="relative h-screen w-full bg-gradient-to-b from-blue-500 to-teal-500 overflow-hidden -z-0"
>
  <div class="w-full h-screen flex items-center justify-center flex-col z-10">
    <a href="https://yasin.guezeldal.com" class="mb-4 text-white/90">
      <svg viewBox="2 1 50.5 50.5" class="w-40 h-40 fill-current">
        <path
          d="M51.4,49.9c1.2-1.4,1.1-3.6-0.2-4.9l-16-16L30,34.2l9.7,9.7H14.8l15-15c0,0,0,0,0,0c0,0,0,0,0,0L51.2,7.6
			c1.4-1.4,1.4-3.8,0-5.2c-1.4-1.4-3.8-1.4-5.2,0L27.2,21L8.5,2.3c-1.4-1.4-3.8-1.4-5.2,0c-1.4,1.4-1.4,3.8,0,5.2L22,26.3L3.3,45
			c-2.3,2.3-0.6,6.3,2.6,6.3h42.6C49.7,51.2,50.7,50.7,51.4,49.9z"
        ></path>
      </svg>
    </a>

    <h1 class="text-5xl font-bold text-white/90">Merhaba,<br /> I'm Yasin.</h1>
  </div>
  <div class="sunlight"></div>
  <div id="surface"></div>
  <div id="reflections"></div>
  <div id="bg"></div>
  <div id="sunshine">
    <div id="sunshine_layer1"></div>
    <div id="sunshine_layer2"></div>
  </div>
</section>

<style>
  :root {
    --ratioW: 1;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html,
  body {
    overscroll-behavior-x: none;
    overscroll-behavior-y: none;
    scroll-behavior: smooth;
  }

  .hero {
    position: relative;
    width: 100vw;
    min-height: 130vh;
    background: linear-gradient(
      to bottom,
      oklch(60% 0.2 230),
      oklch(60% 0.2 180)
    );
  }

  #bg {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 130vh;

    background-image: linear-gradient(
      to bottom,
      white,
      gray 20%,
      gray 60%,
      khaki
    );
    opacity: 0.5;
    mix-blend-mode: overlay;
  }

  .sunlight {
    --duration: 8s;

    opacity: 0.6;
    filter: blur(20px);
    mix-blend-mode: luminosity;
    position: absolute;
    top: 70px;
    right: 0;
    width: 100vw;
    height: 100vh;
    background-repeat: no-repeat;
    background-image: radial-gradient(
        ellipse 50% 20% at 50% 5%,
        rgba(250, 250, 255, 1) 0%,
        rgba(250, 250, 255, 0) 50%
      ),
      repeating-conic-gradient(
        from 0deg at 50% 5%,
        rgb(0 0 0 / 0) 0%,
        rgb(255 255 255 / 0.6) 3%,
        rgb(0 0 0 / 0) 7%,
        rgb(250 160 160 / 0.8) 14%,
        rgb(0 0 0 / 0) 18%,
        rgb(250 160 160 / 0.8) 14%,
        rgb(0 0 0 / 0) 23%,
        rgb(255 149 149 / 0.5) 28%,
        rgb(0 0 0 / 0) 33%
      ),
      radial-gradient(
        ellipse 100% 60% at 50% 1%,
        rgba(250, 250, 255, 0.8) 0%,
        rgba(160, 200, 255, 0.4) 10%,
        rgba(250, 250, 255, 0) 30%
      );
    animation: sunlight var(--duration) linear infinite;
  }

  #surface {
    mix-blend-mode: overlay;
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
  }
  #surface::before,
  #surface::after {
    content: "";
    display: block;
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-image: url(../assets/waves.jpg);
    background-repeat: repeat-x;
    transform: scale(-1, 1);

    --duration: 20s;
    --lowHeight: 25vh;
    --highHeight: 70vh;
    --layerNum: 2;
    --index: 0;
    --opacity: 0.6;

    animation: surface var(--duration) linear infinite;
    animation-delay: calc(
      (var(--duration) / var(--layerNum)) * var(--index) * -1
    );
    opacity: 0;
    mask-image: linear-gradient(to top, white, transparent var(--lowHeight));
  }
  #surface::before {
    --index: 0;
    transform: scale3d(1, -1, 1);
  }
  #surface::after {
    --index: 1;
    transform: scale3d(-1, -1, 1);
  }
  #reflections {
    position: absolute;
    bottom: 0;
    top: 0;
    width: 100vw;
    height: 100vh;
    transform-origin: bottom center;
    transform: scale3d(2, 1, 1);
    opacity: 0.7;
  }
  #reflections::before,
  #reflections::after {
    content: "";
    display: block;
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-image: url(../assets/reflections.png);
    background-repeat: repeat;

    --duration: 25s;
    --height: 30vh;
    --gapY: 0px;

    background-size: calc(100vw / (var(--ratioW))) 40vh;
    animation: reflections calc(var(--duration) * (var(--ratioW))) ease-in-out
      infinite;
    opacity: 0.3;
    mask-image: linear-gradient(
      to top,
      white,
      transparent var(--height),
      transparent
    );
  }
  #reflections::after {
    --duration: 20s;
    --gapY: 10vh;
    animation-delay: -2s;
    transform: scale3d(-1, 1, 1);
  }

  #sunshine {
    mix-blend-mode: luminosity;
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
  }
  #sunshine div {
    content: "";
    display: block;
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform-origin: 50vw 0;
    animation: sunshine 14s ease infinite alternate;

    mask-image: linear-gradient(
      to bottom,
      transparent 5%,
      white 50%,
      white 55%,
      transparent 80%
    );
  }
  #sunshine #sunshine_layer1 {
    background: linear-gradient(
      to right,
      transparent 38%,
      white 40%,
      transparent 42%,
      transparent 52%,
      white 54%,
      transparent 56%
    );
  }
  #sunshine #sunshine_layer2 {
    animation-delay: -2s;
    animation-duration: 16s;
    animation-direction: alternate-reverse;
    background: linear-gradient(
      to right,
      transparent 31%,
      white 33%,
      transparent 35%,
      transparent 52%,
      white 54%,
      transparent 56%
    );
  }
  #sunshine #sunshine_layer3 {
    animation-delay: 15s;
    animation-duration: 18s;
    background: linear-gradient(
      to right,
      transparent 38.5%,
      white 40%,
      transparent 41.5%,
      transparent 47%,
      white 48%,
      transparent 49%,
      transparent 52%,
      white 53%,
      transparent 54%,
      transparent 60%,
      white 61%,
      transparent 62%
    );
  }

  @keyframes surface {
    0% {
      opacity: 0;
      background-position: center bottom;
      background-size: 100% var(--highHeight);
    }
    20% {
      opacity: var(--opacity);
    }
    100% {
      opacity: 0;
      background-position: center bottom calc(-1 * var(--lowHeight));
      background-size: 100% var(--lowHeight);
    }
  }
  @keyframes reflections {
    0% {
      background-position: bottom var(--gapY) left;
    }
    100% {
      background-position: bottom var(--gapY) left -100vw;
    }
  }
  @keyframes sunshine {
    0% {
      opacity: 0.1;
      transform: skew(5deg) scale3d(2, 1.5, 1);
    }
    50% {
      opacity: 0.08;
      transform: skew(4deg) scale3d(1.8, 1, 1);
    }
    100% {
      opacity: 0.1;
      transform: skew(3deg) scale3d(2, 1, 1);
    }
  }

  @keyframes sunlight {
    0% {
      transform: translate(10px, 5px) scale3d(1, 0.99, 1);
    }
    50% {
      transform: translate(10px, -5px) scale3d(1.2, 1.01, 1);
    }
    100% {
      transform: translate(10px, 5px) scale3d(1, 0.99, 1);
    }
  }

  @media (orientation: portrait) {
    :root {
      --ratioW: 1;
    }
  }
  @media (min-aspect-ratio: 1/1) {
    :root {
      --ratioW: 2;
    }
  }
  @media (min-aspect-ratio: 2/1) {
    :root {
      --ratioW: 3;
    }
  }
  @media (min-aspect-ratio: 3/1) {
    :root {
      --ratioW: 4;
    }
  }
  @media (min-aspect-ratio: 4/1) {
    :root {
      --ratioW: 5;
    }
  }
  @media (min-aspect-ratio: 5/1) {
    :root {
      --ratioW: 6;
    }
  }
</style>
